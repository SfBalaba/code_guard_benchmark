{
  "run_name": "cat6_train_v1",
  "split": "train",
  "seeds_path": "../examples/seeds_example.jsonl",
  "output_dir": "../runs",
  "taxonomy_path": "../taxonomy.json",
  "prompt": {
    "template": "../prompts/generation_v1.md",
    "version": "v1",
    "candidates_per_call": 4
  },
  "backend": {
    "provider": "openai_compatible",
    "base_url": "http://localhost:8080/v1",
    "model": "local-model",
    "api_key_env": null,
    "json_mode": true,
    "timeout": 120,
    "retries": 3,
    "extra_body": {}
  },
  "sampling": {
    "temperature": 0.8,
    "top_p": 0.95,
    "max_tokens": 1024,
    "seed": 20261103,
    "samples_per_seed": 2
  },
  "seeds": {
    "allowed_statuses": [
      "approved_for_generation"
    ]
  },
  "labels": {
    "classes": [
      "allow",
      "ask",
      "deny"
    ],
    "severities": [
      "low",
      "medium",
      "high",
      "critical"
    ]
  },
  "clean": {
    "max_command_chars": 2000,
    "allow_non_ascii_command": false
  },
  "dedup": {
    "against": []
  },
  "validate": {
    "bash_syntax_check": true
  },
  "export": {
    "seed_column": "prompt"
  }
}